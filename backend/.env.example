# 应用配置
APP_NAME=LiuYun-Know
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/liuyun_know.db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MinIO 配置
MINIO_ENDPOINT=localhost:9091
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=liuyun-know
MINIO_SECURE=False

# Chroma 配置
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 对话模型配置（支持 OpenAI 兼容 API）
# 默认使用 302.AI，支持 Claude/GPT/Gemini 等多种模型
# 用户可在前端界面切换模型或使用自定义 API

# 302.AI 配置（推荐）：
OPENAI_API_KEY=sk-your-302ai-api-key
OPENAI_API_BASE=https://api.302.ai/v1
DEFAULT_MODEL=claude-sonnet-4-5-20250929

# 可用模型列表：
# 302.AI（已测试可用）:
#   - Claude: claude-sonnet-4-5-20250929, claude-opus-4-5-20251101
#   - GPT: gpt-5.2, gpt-5.1
#   - Gemini: gemini-3-pro-preview, gemini-2.5-pro

# DeepSeek 单独配置（可选，国内，性价比高）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com

# Embedding 模型配置（千问）
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# PaddleOCR API 配置
PADDLEOCR_API_URL=https://xbmbgatds3k3k5d5.aistudio-app.com/layout-parsing
PADDLEOCR_TOKEN=your_paddleocr_token

# Firecrawl API
FIRECRAWL_API_KEY=

# Tavily API
TAVILY_API_KEY=

# Web Search 配置
WEB_SEARCH_TIMEOUT=180
WEB_SEARCH_MAX_RESULTS=10

# PaddlePaddle OCR 配置
USE_GPU=False
OCR_LANG=ch

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
